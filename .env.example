# Every key below is OPTIONAL. Each source auto-skips if its key is
# missing — start with just one filled in, add the rest whenever.

# xAI / Grok — X (Twitter) + Reddit search. ~$5/1000 tool calls.
# Get key: https://console.x.ai
XAI_API_KEY=

# Google Gemini — FREE Google Search grounding, 5,000 grounded prompts/month.
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily — FREE, 1,000 search credits/month, permanent, no card needed.
# Purpose-built for AI agents, returns clean structured results.
# Get key: https://app.tavily.com
TAVILY_API_KEY=

# Apify — Twitter/X search via a community scraper Actor. Free tier: $5/mo
# platform credit, no card. ~$4.20/month at default settings, fits free tier.
#
# ⚠️ USE A DEDICATED/THROWAWAY X ACCOUNT FOR THIS, NOT YOUR PERSONAL ONE.
# Search mode needs a logged-in X session. If X detects automated scraping
# on that session, that account takes the hit — a throwaway account keeps
# your real account safe. Cookies expire every few weeks; refresh them by
# logging into x.com with the dedicated account, then DevTools (F12) ->
# Application -> Cookies -> x.com -> copy auth_token and ct0 values.
# Get Apify token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
APIFY_TWITTER_COOKIE=
APIFY_MAX_RESULTS_PER_TOPIC=5

# Reddit official API — free, but needs manual pre-approval (2-4 weeks) as
# of the Responsible Builder Policy (Nov 2025).
# Register: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=leadgen/1.0 by u/yourusername

# DuckDuckGo needs no key — always on, free, unofficial best-effort.

# Telegram — free push notifications + report delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# IMPORTANT: Groq (console.groq.com) is NOT Grok/xAI (console.x.ai) — easy
# mix-up, different companies. Groq free tier: 14,400 requests/day, no card,
# but NO live web/X search — used here only as a free drafting model.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — optional. Used as a FALLBACK drafting model only if neither
# XAI_API_KEY nor GROQ_API_KEY is set (free models don't do live web search,
# so this doesn't add a new search source — just drafting).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Load / reliability tuning (safe defaults, override if needed) ----
SOURCE_TIMEOUT_SECONDS=45
MAX_RETRIES=3
MAX_CONCURRENT_SOURCES=4
TOP_N_FOR_DRAFTS=15
LEADGEN_DB_PATH=leads.db
